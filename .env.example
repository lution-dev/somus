# Firebase (client) — nunca commitar valores reais.
# Copie para `.env.local` (gitignored) e preencha com o Console Firebase.
# No Vercel: Project → Settings → Environment Variables (Production + Preview).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional (scripts locais)
# SOMUS_SCRIPT_USER_UID=
